# Environment Configuration for Email.Pro
# Do not commit real credentials or secrets to this file.

# Optional public API URL for custom client routing
NEXT_PUBLIC_API_URL=

# Gemini API key (server-side only)
GEMINI_API_KEY=

# Renderer mode:
# Development: 'local' (uses node worker process) or 'container' (dispatches to isolated container)
# Production: MUST be 'container' (setting 'local' in production will throw SECURITY_CONFIGURATION_ERROR)
# Defaults safely to 'container' in production if omitted
RENDERER_MODE=

# URL of the isolated renderer container (default: http://localhost:3001 or http://renderer:3001 in Docker network)
RENDERER_URL=
